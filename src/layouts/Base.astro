---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Arrow from '../components/Arrow.astro';
import BookingStrip from '../components/BookingStrip.astro';
import { site, nav, sectors, markets } from '../data/site';

interface Props {
  title: string;
  description: string;
  booking?: boolean;
  bookingHeadline?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  preloadPoster?: string;
}
const { title, description, booking = true, bookingHeadline, schema = [], noindex = false, preloadPoster } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path === '/' ? '/' : path, site.url).href;
const og = new URL('/og.png', site.url).href;
const isActive = (item: { href: string; match?: string[] }) =>
  path === item.href || (item.match ?? []).includes(path) || (item.href !== '/' && path.startsWith(item.href + '/'));

const org = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#org`,
      name: 'Hitch Studio',
      url: site.url,
      logo: `${site.url}/icon-512.png`,
      email: site.email,
      slogan: site.signoff,
      parentOrganization: { '@type': 'Organization', name: 'Rope Digital LLC', url: site.ropeUrl },
      sameAs: [],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#business`,
      name: 'Hitch Studio',
      url: site.url,
      image: og,
      email: site.email,
      priceRange: 'US$1,500–US$3,900',
      areaServed: [{ '@type': 'Country', name: 'Australia' }, { '@type': 'Country', name: 'United Kingdom' }, { '@type': 'Country', name: 'United States' }],
      parentOrganization: { '@id': `${site.url}/#org` },
    },
  ],
};
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en-AU" href={canonical} />
  <link rel="alternate" hreflang="en-GB" href={canonical} />
  <link rel="alternate" hreflang="en-US" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/inter-tight.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-mono-500.woff2" as="font" type="font/woff2" crossorigin />
  {preloadPoster && <link rel="preload" as="image" href={preloadPoster} fetchpriority="high" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hitch Studio" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:locale:alternate" content="en_GB" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.replace('no-js','js');</script>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="wrap-wide">
      <a href="/"><Logo /></a>
      <nav class="nav" aria-label="Main">
        {nav.map((item) => <a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        {site.phone
          ? <a class="header-contact" href={`tel:${site.phone}`} aria-label="Call Hitch Studio" data-track="click_to_call"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg></a>
          : <a class="header-contact" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`} data-track="click_to_email"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/></svg></a>}
        <a class="btn btn-sm header-book" href="/book" data-track="cta_book">Book a call</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu><span></span><span></span><span class="sr-only">Menu</span></button>
      </div>
    </div>
  </header>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}<Arrow /></a></li>)}
      <li><a href="/about">About<Arrow /></a></li>
    </ul>
    <div class="stack-16">
      <a class="btn btn-lg" style="width:100%" href="/book">Book a call <Arrow /></a>
      <p class="small muted">{site.phone ? <a href={`tel:${site.phone}`}>{site.phone}</a> : null} <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>

  <main id="main">
    <slot />
  </main>

  {booking && <BookingStrip headline={bookingHeadline} />}

  <footer class="site-footer on-black">
    <div class="wrap">
      <div class="footer-top">
        <div class="stack-24">
          <a href="/"><Logo tone="lime" endorsed /></a>
          <p class="muted measure">{site.positioning} Fixed prices in USD for Australia, the UK and the US.</p>
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="footer-cols">
          <div>
            <h2 class="mono">Sectors</h2>
            <ul>{sectors.map((s) => <li><a href={s.path}>{s.label}</a></li>)}</ul>
          </div>
          <div>
            <h2 class="mono">Studio</h2>
            <ul>
              <li><a href="/work">Work</a></li>
              <li><a href="/pricing">Pricing</a></li>
              <li><a href="/tools">Tools</a></li>
              <li><a href="/how-it-works">How it works</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/book">Book a call</a></li>
            </ul>
          </div>
          <div>
            <h2 class="mono">Markets</h2>
            <ul>{markets.map((m) => <li>{m}</li>)}</ul>
          </div>
          <div>
            <h2 class="mono">Legal</h2>
            <ul>
              <li><a href="/terms">Terms</a></li>
              <li><a href="/privacy">Privacy</a></li>
              <li><button type="button" data-cookie-open class="footer-cookie">Cookie settings</button></li>
            </ul>
          </div>
        </div>
      </div>
      <p class="footer-sign" aria-hidden="true">Built without a hitch.</p>
      <div class="footer-bottom">
        <p class="mono">© {new Date().getFullYear()} Rope Digital LLC, trading as Hitch Studio</p>
        <p class="mono"><a href={site.ropeUrl} rel="noopener">A Rope Digital studio</a> · All prices in USD</p>
      </div>
    </div>
  </footer>

  <div class="cookie on-black" role="dialog" aria-modal="false" aria-labelledby="cookie-h" data-cookie>
    <h2 id="cookie-h" class="h4">Cookies.</h2>
    <p>We use essential cookies to run this site. With your OK, we also use analytics and ad cookies to see what works. Read our <a href="/privacy#cookies">privacy notice</a>.</p>
    <div class="row">
      <button class="btn btn-white btn-sm" type="button" data-consent="all">Accept all</button>
      <button class="btn btn-ghost-light btn-sm" type="button" data-consent="essential">Essential only</button>
    </div>
  </div>

  <script src="../scripts/main.ts"></script>
</body>
</html>

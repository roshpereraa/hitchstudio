---
// "What you get": a front door drawn as an engineering elevation, with callouts.
const L = [
  { label: '01 Design', y: 74, tx: 196, ty: 92 },
  { label: '02 Copy', y: 160, tx: 214, ty: 156 },
  { label: '03 Photos', y: 246, tx: 230, ty: 210 },
];
const R = [
  { label: '04 Google profile', y: 74, tx: 334, ty: 64 },
  { label: '05 Hosting', y: 160, tx: 318, ty: 196 },
  { label: '06 Care', y: 246, tx: 306, ty: 258 },
];
---
<svg class="schematic" viewBox="0 0 520 400" role="img" aria-labelledby="door-title">
  <title id="door-title">A front door drawn as a technical elevation, labelled with what every site includes.</title>
  <path class="draw" style="--d:100ms" d="M160 360V60h200v300" />
  <path class="draw faint" style="--d:200ms" d="M140 360h240M152 60h216M152 52h216v8" />
  <rect class="draw" style="--d:300ms" x="208" y="150" width="104" height="210" />
  <rect class="draw faint" style="--d:450ms" x="220" y="164" width="80" height="80" />
  <rect class="draw faint" style="--d:500ms" x="220" y="256" width="80" height="92" />
  <circle class="draw" style="--d:600ms" cx="298" cy="258" r="4" />
  <path class="draw" style="--d:400ms" d="M208 130h104v20H208z" />
  <text x="260" y="144" text-anchor="middle" class="fade" style="--d:800ms">No. 12</text>
  <rect class="draw" style="--d:350ms" x="182" y="78" width="156" height="32" />
  <text x="260" y="99" text-anchor="middle" class="fade" style="--d:800ms">Open for business</text>
  <path class="draw faint" style="--d:700ms" d="M196 360v-8h128v8M188 368h144" />
  {L.map((c, i) => (
    <g style={`--d:${900 + i * 110}ms`}>
      <path class="draw faint" d={`M100 ${c.y}H128L${c.tx} ${c.ty}`} />
      <rect class="draw node-fill" x={c.tx - 2.5} y={c.ty - 2.5} width="5" height="5" />
      <text x="0" y={c.y + 4} class="fade">{c.label}</text>
    </g>
  ))}
  {R.map((c, i) => (
    <g style={`--d:${1230 + i * 110}ms`}>
      <path class="draw faint" d={`M392 ${c.y}H372L${c.tx} ${c.ty}`} />
      <rect class="draw node-fill" x={c.tx - 2.5} y={c.ty - 2.5} width="5" height="5" />
      <text x="400" y={c.y + 4} class="fade">{c.label}</text>
    </g>
  ))}
  <g class="fade" style="--d:1600ms">
    <path class="draw faint" d="M160 384h200M160 378v12M360 378v12" />
    <text x="260" y="398" text-anchor="middle">One fixed price</text>
  </g>
</svg>

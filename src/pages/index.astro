---
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import Arrow from '../components/Arrow.astro';
import Headline from '../components/Headline.astro';
import CaseCard from '../components/CaseCard.astro';
import PackageCards from '../components/PackageCards.astro';
import ProcessSchematic from '../components/ProcessSchematic.astro';
import DoorSchematic from '../components/DoorSchematic.astro';
import { sectors, cases, included, process, aiUseCases } from '../data/site';
import AgentSchematic from '../components/AgentSchematic.astro';
---
<Base
  title="Hitch Studio | Websites and AI for the business you already run"
  description="Fixed-price websites for trades, clinics and property businesses, and agentic AI built into existing companies. Australia, the UK and the US. Book a 20-minute call."
  preloadPoster="/video/hero-v2.webp"
>
  <!-- Hero: one framed scene. Video fills the frame, copy sits on it, bottom left. -->
  <section class="hero-scene" aria-labelledby="hero-h">
    <div class="wrap-wide">
      <div class="scene-frame on-black scale-in">
        <div id="hero-video" class="scene-media">
          <Video name="hero-v2" mobile="hero-v2-mobile" alt="A builder on the phone on site, a dentist with a patient, a website on a tablet, a screen reflected in glasses, a dashboard, a phone ringing." eager hero />
        </div>
        <div class="scene-shade" aria-hidden="true"></div>
        <div class="scene-content">
          <p class="eyebrow mono reveal"><span class="tick" aria-hidden="true"></span>Websites and AI</p>
          <h1 id="hero-h" class="scene-title lines" data-reveal>
            <span class="line"><span>Websites that win the work.</span></span>
            <span class="line"><span style="--d:90ms">AI that does <span class="hl">it.</span></span></span>
          </h1>
          <p class="scene-lede reveal" style="--d:220ms">Sharp, fast websites for trades, clinics and property businesses, live in days. And AI agents built into the business you already run.</p>
          <div class="scene-ctas reveal" style="--d:300ms">
            <a class="btn btn-lg btn-white" href="/book" data-track="cta_book">Book a call <Arrow /></a>
            <a class="btn btn-lg btn-ghost-light" href="/ai">AI for your business</a>
          </div>
        </div>
        <button class="pause-btn scene-pause" type="button" aria-controls="hero-video" aria-pressed="false" data-pause>
          <svg class="i-pause" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><rect x="1" y="0" width="3" height="10"/><rect x="6" y="0" width="3" height="10"/></svg>
          <svg class="i-play" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M1 0l9 5-9 5z"/></svg>
          <span data-label>Pause</span><span class="sr-only"> background video</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="proof" aria-label="Why Hitch Studio">
    <div class="wrap-wide">
      <p class="proof-line mono-m"><span>Websites</span><span class="sep" aria-hidden="true"></span><span>AI agents</span><span class="sep" aria-hidden="true"></span><span>Fixed prices</span><span class="sep" aria-hidden="true"></span><span>You own it</span></p>
      <div class="logos" aria-label="Rope Digital clients">
        <span>Flexia Construction</span>
        <span class="l-wide">4S GROUP</span>
        <span>FORM.</span>
        <span class="l-serif">Nexus Developments</span>
      </div>
    </div>
  </section>

  <!-- Two services -->
  <section class="section rule-top" aria-labelledby="services-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="stack-16">
          <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>What we do</p>
          <Headline id="services-h" lines={['Two things.', 'Done properly.']} />
        </div>
        <p class="body-l muted reveal">The website that brings the work in. The AI that helps get it done. Take one, or both.</p>
      </div>
      <div class="services">
        <a class="service reveal" href="#sectors">
          <p class="mono muted">01 · Websites</p>
          <h3 class="display-m">Your front door, online.</h3>
          <p class="muted">Fixed-price sites for trades, clinics and property businesses. Written, designed and live in 2–4 working days, from US$1,500.</p>
          <span class="link">Websites <Arrow /></span>
        </a>
        <a class="service reveal" style="--d:90ms" href="/ai">
          <p class="mono muted">02 · AI implementation</p>
          <h3 class="display-m">AI that does the work.</h3>
          <p class="muted">Agents built into your existing tools: {aiUseCases.slice(0, 3).map((u) => u.title.toLowerCase()).join(', ')}. Piloted on one workflow, with a person in control.</p>
          <span class="link">AI implementation <Arrow /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Sectors -->
  <section id="sectors" class="section bg-ash" aria-labelledby="sectors-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="stack-16">
          <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>Websites</p>
          <Headline id="sectors-h" lines={['Built for the', 'businesses you visit.']} />
        </div>
        <p class="body-l muted reveal">Three sectors, three design kits, one process. Any business with a front door is welcome.</p>
      </div>
      <div class="sector-cards">
        {sectors.map((s, i) => (
          <a class="sector-card reveal" style={`--d:${i * 90}ms`} href={s.path}>
            <Video name={s.card} alt="" sizes="(min-width: 768px) 33vw, 100vw" />
            <div class="sector-card-body">
              <p class="mono" style="color:#cfcfcf">0{i + 1}</p>
              <h3 class="h3">{s.label}.<span class="go" aria-hidden="true"><Arrow class="" /></span></h3>
              <p class="small" style="color:#dedede">{s.cardLine}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="section" aria-labelledby="work-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="stack-16">
          <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>Work</p>
          <Headline id="work-h" lines={['Sites that get', 'the phone ringing.']} />
        </div>
        <a class="link reveal" href="/work">See all the work <Arrow /></a>
      </div>
      <div class="case-grid three">
        {cases.map((c, i) => <CaseCard c={c} feature={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section class="section bg-ash" aria-labelledby="get-h">
    <div class="wrap">
      <div class="split wide-right">
        <div class="stack-32">
          <div class="stack-16">
            <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>What you get</p>
            <Headline id="get-h" lines={['Everything your', 'front door needs.']} />
          </div>
          <div class="reveal" style="max-width:420px"><DoorSchematic /></div>
        </div>
        <ol class="ruled">
          {included.map((item, i) => (
            <li class="reveal" style={`--d:${i * 60}ms`}>
              <span class="idx mono">0{i + 1}</span>
              <h3 class="h4">{item.title}.</h3>
              <p class="muted">{item.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" aria-labelledby="how-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="stack-16">
          <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>How it works</p>
          <Headline id="how-h" lines={['Four steps.', 'Live in days.']} />
        </div>
        <a class="link reveal" href="/how-it-works">See the full process <Arrow /></a>
      </div>
      <div class="reveal" style="max-width:760px;margin:0 auto 72px"><ProcessSchematic /></div>
      <ol class="steps">
        {process.slice(0, 4).map((s, i) => (
          <li class="step reveal" style={`--d:${i * 90}ms`}>
            <p class="num mono"><span>0{i + 1}</span><span>{s.time}</span></p>
            <h3 class="h3">{s.name}.</h3>
            <p class="muted">{s.short}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- AI -->
  <section class="section on-black" aria-labelledby="ai-h">
    <div class="wrap">
      <div class="split wide-right">
        <div class="stack-32">
          <div class="stack-16">
            <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>AI implementation</p>
            <Headline id="ai-h" lines={['AI, built into', 'the business', 'you already run.']} />
          </div>
          <div class="reveal" style="max-width:480px"><AgentSchematic /></div>
          <a class="btn btn-lime reveal" style="align-self:flex-start" href="/ai">How it works <Arrow /></a>
        </div>
        <ol class="ruled">
          {aiUseCases.map((u, i) => (
            <li class="reveal" style={`--d:${i * 60}ms`}>
              <span class="idx mono">0{i + 1}</span>
              <h3 class="h4">{u.title}.</h3>
              <p class="muted">{u.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="section bg-ash" aria-labelledby="pkg-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="stack-16">
          <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>Website packages</p>
          <Headline id="pkg-h" lines={['One fair price,', 'agreed up front.']} />
        </div>
        <p class="body-l muted reveal">Three websites. No hourly billing, no surprise invoices. Every build includes 12 months of care.</p>
      </div>
      <PackageCards popular="growth" />
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section on-black" aria-label="What clients say">
    <div class="wrap">
      <figure class="testimonial">
        <div class="reveal"><Video name="quote" class="media-lg" alt="" sizes="(min-width: 1024px) 40vw, 100vw" /></div>
        <div class="reveal" style="--d:120ms">
          <p class="eyebrow mono"><span class="tick" aria-hidden="true"></span>Trades · Australia · Sector demo</p>
          <blockquote class="mt-32"><p>“One call’s worth of notes. Three days later, a site we’re proud to send people to.”</p></blockquote>
          <figcaption>
            <span class="h4">Owner, Ironbark Builders.</span>
            <span class="mono muted">Growth package · Live in 3 days</span>
          </figcaption>
        </div>
      </figure>
    </div>
  </section>
</Base>
